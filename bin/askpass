#!/usr/bin/env bash
set -euo pipefail

# 一時ファイルの作成と、スクリプト終了時（成功・失敗・強制終了）の確実な削除
TMP_FILE=$(mktemp)
trap 'rm -f "$TMP_FILE"' EXIT INT TERM

# dialog の実行（--insecure で *** を表示）
# CancelやESCが押されたら、パスワードを出力せずにエラー終了（exit 1）する
if dialog --insecure --passwordbox "Enter password:" 10 40 2> "$TMP_FILE"; then
    # 成功した場合のみ、ファイルの中身を出力
    cat "$TMP_FILE"
    echo # 改行を付与
else
    # キャンセル時は標準エラー出力に改行だけ入れておく（プロンプト崩れ防止）
    echo >&2
    exit 1
fi
