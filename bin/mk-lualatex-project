#!/usr/bin/env bash
# Generator for modular LuaLaTeX book projects following strict macro naming conventions
set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") <project-dir-name> [project-title]"
    echo "Example: $(basename "$0") cybernetics-monograph \"Cybernetics and Cognition\""
    exit 1
}

[[ $# -lt 1 ]] && usage

PROJECT_DIR="$1"
PROJECT_TITLE="${2:-$1}"
PROJECT_SLUG="${PROJECT_DIR//-/_}"

if [[ -d "$PROJECT_DIR" ]]; then
    echo "Error: Directory '$PROJECT_DIR' already exists." >&2
    exit 1
fi

echo "[*] Initializing LuaLaTeX project in: $PROJECT_DIR"

# 1. ディレクトリツリーの生成
mkdir -p "$PROJECT_DIR"/{.ctags.d,build,db/seed,src/{chapters/{00_intro,01_foundations,99_colophon},dot,epigraph,figures,fonts,images,lua,math,old,pikchr,plots,preamble,tables,tikz}}

cd "$PROJECT_DIR"

# 2. .gitignore
cat << 'EOF' > .gitignore
build/
tags
*.pdf
!src/images/*.pdf
db/seed/
.DS_Store
EOF

# 3. .latexmkrc (LuaLaTeX + buildディレクトリ指定 + ビルド成功時バックグラウンド ctags)
cat << 'EOF' > .latexmkrc
$pdf_mode = 4; # lualatex
$lualatex = 'lualatex -shell-escape -synctex=1 -interaction=nonstopmode %O %S';
$out_dir  = 'build';$success_cmd = 'ctags -R src/ &';
EOF

# 4. .ctags.d/latex.ctags
cat << 'EOF' > .ctags.d/latex.ctags
--langdef=texmacro
--map-texmacro=.tex
--kinddef-texmacro=m,macro,LaTeX Macros
--regex-texmacro=/\\newcommand\*?\{\\([a-zA-Z0-9]+)\}/\1/m/
--regex-texmacro=/\\def\\([a-zA-Z0-9]+)/\1/m/
--regex-texmacro=/\\DeclareMathOperator\*?\{\\([a-zA-Z0-9]+)\}/\1/m/
EOF

# 5. CODING_CONVENTIONS.md
cat << 'EOF' > CODING_CONVENTIONS.md
# LaTeX Macro Coding Standard: Namespace & Prefix Conventions

This standard defines a macro naming scheme designed for large-scale academic books and mathematical monographs (Book class). It prevents identifier collisions in the global TeX scope while maximizing discoverability and efficiency via Vim completion (`<C-n>` / `<C-p>`), `ctags`, and `ripgrep` (`rg`).

---

## 1. Core Principles

1. **Global Namespace Pollution Prevention**  
   Since standard TeX macro names consist exclusively of alphabetical characters (`[A-Za-z]`), explicit semantic camelCase prefixes are mandatory to eliminate naming collisions with package-level commands.
2. **Keystroke & Completion Optimization**  
   Typing a short prefix (3–4 characters) followed by the editor's auto-completion trigger immediately narrows the candidate list to the designated semantic scope.
3. **Symmetry Between Math & Natural Language**  
   For any single conceptual entity, bind its mathematical symbol, English textual form, Japanese translation, abbreviated acronym, and expanded formal name to a unified base identifier.

---

## 2. Prefix Hierarchy

| Prefix | Classification / Role | Semantics & Purpose | Examples | Rendered Output (Target) |
| :--- | :--- | :--- | :--- | :--- |
| `\mth...` | **Mathematical Glyph / Operator** | Mathematical models, operators, symbols (math-mode context) | `\mthEgo`<br>`\mthWisdom` | $\mathcal{E}_{\text{ego}}$<br>$\mathcal{W}_{\text{wisdom}}$ |
| `\txt...` | **Standard Concept Text** | Standard English concept names and proper nouns in prose | `\txtWholeSelf` | WholeSelf |
| `\ja...` | **Japanese Terminology** | Japanese canonical terminology, glossaries, translations | `\jaWholeSelf` | 全体自己 |
| `\abbr...` | **Abbreviation / Acronym** | Acronyms and shorthand tokens (tables, inline abbreviations) | `\abbrDAG` | DAG |
| `\full...` | **Expanded / Formal Text** | Fully expanded formal names (definitions, title pages) | `\fullWholeSelf` | Unified WholeSelf Identity |

---

## 3. Macro Definition Patterns (`src/preamble/macros.tex`)

Define orthogonal macros for the same conceptual entity using distinct prefixes:

```latex
% 1. Mathematical Symbol
\newcommand{\mthExample}{\mathcal{M}_{\mathrm{ex}}}

% 2. Standard Concept Text (Always append \xspace for prose)
\newcommand{\txtExample}{Core Example\xspace}

% 3. Japanese Terminology
\newcommand{\jaExample}{中核概念\xspace}

% 4. Abbreviation
\newcommand{\abbrExample}{CE\xspace}

% 5. Expanded / Formal Text
\newcommand{\fullExample}{Comprehensive Core Example Model\xspace}

```

---

## 4. Editor & CLI Toolchain Integration

* **Neovim / Vim:** Type `\mth` or `\ja` and press `<C-n>` to trigger context completion.
* **ripgrep:** `rg '\\mthExample\b' src/`
* **ctags:** Triggered automatically via `.latexmkrc` or manually with `make tags`.
EOF

# 6. Makefile

cat << EOF > Makefile
PROJECT = ${PROJECT_SLUG}
MAIN    = src/$(PROJECT).tex
BUILD   = build

.PHONY: all pdf clean tags watch

all: pdf

pdf: tags
latexmk $(MAIN)

watch:
latexmk -pvc $(MAIN)

tags:
@if command -v ctags >/dev/null 2>&1; then \
ctags -R src/ ; \
echo "[+] ctags updated" ; \
fi

clean:
latexmk -C $(MAIN)
rm -rf $(BUILD) tags
EOF

# 7. Preamble 各種ファイル

cat << 'EOF' > src/preamble/packages.tex
\usepackage{luatexja}
\usepackage{luatexja-fontspec}
\usepackage{amsmath,amssymb,amsfonts,amsthm}
\usepackage{mathtools}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{microtype}
\usepackage{xspace}
\usepackage{hyperref}
EOF

cat << 'EOF' > src/preamble/init.tex
\hypersetup{
colorlinks=true,
linkcolor=black,
citecolor=black,
urlcolor=blue
}
EOF

cat << 'EOF' > src/preamble/macros.tex
% Prefix convention conforms to CODING_CONVENTIONS.md
% \mth: Math glyphs | \txt: Text concept | \ja: Japanese | \abbr: Acronym | \full: Formal expanded

\newcommand{\txtSystemName}{Cybernetic Bayesian Engine\xspace}
\newcommand{\abbrSystemName}{CBE\xspace}
\newcommand{\jaSystemName}{サイバネティック・ベイズ推論機関\xspace}
\newcommand{\mthSystemOperator}{\mathcal{B}_{\mathrm{cbe}}}
EOF

cat << 'EOF' > src/preamble/math_commands.tex
% Global Math Operators & Delimiters
\DeclareMathOperator*{\argmax}{arg,max}
\DeclareMathOperator*{\argmin}{arg,min}
\newcommand{\condbar}{,\middle|,}
EOF

cat << 'EOF' > src/preamble/environments.tex
% Theorem / Proof Environments
\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{hypothesis}{Hypothesis}[chapter]
\newtheorem{protocol}{Protocol}[chapter]
EOF

cat << 'EOF' > src/preamble/terms.tex
% Reserved terminology definitions
EOF

# 8. 章ファイル (Chapters)

cat << 'EOF' > src/chapters/00_intro/main.tex
\chapter{Introduction}
This project is powered by LuaLaTeX, configured with strict macro isolation standards.

The core operator \mthSystemOperator governs \txtSystemName (\abbrSystemName: \jaSystemName).
EOF

cat << 'EOF' > src/chapters/01_foundations/main.tex
\chapter{Theoretical Foundations}
\begin{definition}[Cybernetic Observation]
Let $\mathcal{D}$ denote the evidence set. The update equation is formulated as:
\begin{equation}
P(\mthSystemOperator \condbar \mathcal{D}) = \frac{P(\mathcal{D} \condbar \mthSystemOperator) P(\mthSystemOperator)}{P(\mathcal{D})}
\end{equation}
\end{definition}
EOF

cat << 'EOF' > src/chapters/99_colophon/main.tex
\chapter*{Colophon}
\addcontentsline{toc}{chapter}{Colophon}
Typeset with LuaLaTeX and UNIX tools.
EOF

# 9. メインファイル (src/${PROJECT_SLUG}.tex)

cat << EOF > "src/${PROJECT_SLUG}.tex"
\documentclass[11pt,a4paper,openany]{book}

% Preamble modules
\input{src/preamble/packages.tex}
\input{src/preamble/init.tex}
\input{src/preamble/math_commands.tex}
\input{src/preamble/macros.tex}
\input{src/preamble/environments.tex}
\input{src/preamble/terms.tex}

\title{${PROJECT_TITLE}}
\author{Author}
\date{\today}

\begin{document}

\frontmatter
\maketitle
\tableofcontents

\mainmatter
\input{src/chapters/00_intro/main.tex}
\input{src/chapters/01_foundations/main.tex}

\backmatter
\input{src/chapters/99_colophon/main.tex}

\end{document}
EOF

# 10. 初期 ctags のビルド (ctags があれば)

if command -v ctags >/dev/null 2>&1; then
ctags -R src/
fi

echo "[✔] Successfully initialized ${PROJECT_DIR}."
echo "    cd ${PROJECT_DIR} && make"
