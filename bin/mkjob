#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="${1:-${WORK_BASE_DIR:-.}}"

if [[ ! -d "$BASE_DIR" ]]; then
    echo "Error: Directory '$BASE_DIR' does not exist." >&2
    exit 1
fi

# Format: YYYYMMDD_HHMMSS_<short_uuid> (safe, no colons, tab-completable)
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SHORT_ID=$(uuidgen | tr -d '-' | cut -c 1-6)
WORK_DIR="${BASE_DIR}/${TIMESTAMP}_${SHORT_ID}"

mkdir -p "$WORK_DIR"

# Clean up on cancellation, error, or Ctrl+C
cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        echo -e "\nAborted. Removing incomplete directory: $WORK_DIR" >&2
        rm -rf "$WORK_DIR"
    fi
    clear 2>/dev/null || true
    exit "$exit_code"
}
trap cleanup EXIT INT TERM

# 1. Customer / Client Name
CUSTOMER_TMP=$(mktemp)
dialog --title "New Job: Client Information" \
       --inputbox "Enter client name or organization:" 10 50 \
       2> "$CUSTOMER_TMP"

CLIENT_NAME=$(cat "$CUSTOMER_TMP")
rm -f "$CUSTOMER_TMP"

if [[ -z "${CLIENT_NAME// /}" ]]; then
    echo "Error: Client name cannot be empty." >&2
    exit 1
fi

echo "$CLIENT_NAME" > "${WORK_DIR}/customer.txt.m4"

# 2. Text input helper (delegates to $EDITOR for frictionless editing)
edit_file() {
    local target="$1"
    local prompt="$2"
    local editor="${EDITOR:-nano}"

    [[ -f "$target" ]] || touch "$target"

    dialog --title "$prompt" \
           --yesno "Open $prompt in $editor?" 8 50

    clear
    "$editor" "$target"
}

edit_file "${WORK_DIR}/request_details.txt.m4" "Job Scope & Requirements"
edit_file "${WORK_DIR}/condition.txt.m4" "Estimates, Deadlines & Terms"

# Disarm trap on successful completion
trap - EXIT INT TERM
clear

echo "Successfully initialized job directory:"
echo "  Path: $WORK_DIR"
echo ""
ls -la "$WORK_DIR"
