#!/usr/bin/env bash
# Extract 802.11 Probe Requests from PCAP using tshark
set -euo pipefail

if [[ $# -lt 1 || ! -f "$1" ]]; then
    echo "Usage: $(basename "$0") <capture.pcap>" >&2
    exit 1
fi

exec tshark -r "$1" \
  -Y "wlan.fc.type_subtype == 0x04" \
  -T fields \
  -e wlan.da \
  -e wlan.sa \
  -e wlan.ssid \
  -E separator=", " \
  -E occurrence=f \
  2>/dev/null | sort -u
